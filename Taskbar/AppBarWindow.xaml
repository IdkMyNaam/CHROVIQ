<Window x:Class="WindowsCustomizer.AppBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CHROVIQ taskbar"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Width="800" Height="40"
        AllowsTransparency="True" Background="Transparent">
    <!-- Transparent window that docks on a screen edge; the bar itself is a TaskbarView (set in code).
         Fully transparent parts (beside a floating dock) let clicks through to the windows behind. -->
</Window>
