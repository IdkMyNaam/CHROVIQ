<UserControl x:Class="WindowsCustomizer.TaskbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:WindowsCustomizer"
             Foreground="{DynamicResource BarForeground}" FontFamily="Segoe UI" FontSize="12"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Layout rounding: icons land on whole pixels instead of being smeared over two. -->
    <!-- Draws one taskbar from a design. Used by the real bars (AppBarWindow) and by the
         designer's preview. Colors and sizes come from the design's Look (see ApplyLook). -->
    <UserControl.Resources>
        <!-- Defaults; replaced by ApplyLook. -->
        <SolidColorBrush x:Key="BarBackground" Color="#F01C1C1C" />
        <SolidColorBrush x:Key="BarForeground" Color="White" />
        <SolidColorBrush x:Key="BarHover" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="BarActive" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="IconTint" Color="White" />
        <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>
        <!-- Active marker (Look.ActiveMarker); the defaults are the line. -->
        <Thickness x:Key="MarkerLineThickness">0,0,0,2</Thickness>
        <Visibility x:Key="MarkerVisibility">Collapsed</Visibility>
        <sys:Double x:Key="MarkerWidth">5</sys:Double>
        <sys:Double x:Key="MarkerHeight">5</sys:Double>
        <VerticalAlignment x:Key="MarkerVerticalAlignment">Bottom</VerticalAlignment>
        <Thickness x:Key="MarkerMargin">0,0,0,2</Thickness>
        <x:Null x:Key="MarkerMask" />
        <!-- Window icon sizes (Look.WindowIconSize). -->
        <sys:Double x:Key="TaskIconSize">16</sys:Double>
        <sys:Double x:Key="TaskIconOnlySize">24</sys:Double>
        <!-- Tinted icons (Look.TintIcons): the one-color copy is shown, the full-color icon only on hover. -->
        <Visibility x:Key="TintIconVisibility">Collapsed</Visibility>
        <sys:Double x:Key="ColorIconOpacity">1</sys:Double>

        <!-- Buttons on the bar: a background (active state), a hover layer on top of it, and the content.
             The hover layer's color comes from Tag: the design's hover color, or an app's icon color ("glow").
             Two versions: the highlight switches instantly, or fades (Look.HoverFade). -->
        <ControlTemplate x:Key="BarButtonInstantTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource ButtonCornerRadius}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{DynamicResource MarkerLineThickness}"
                    RenderTransformOrigin="0.5,0.5">
                <Grid>
                    <Border x:Name="HoverLayer" Opacity="0" CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    <!-- Active marker other than the line (Look.ActiveMarker): dot, pill or glow, in the line's color. -->
                    <Border Background="{TemplateBinding BorderBrush}" Visibility="{DynamicResource MarkerVisibility}"
                            Width="{DynamicResource MarkerWidth}" Height="{DynamicResource MarkerHeight}"
                            VerticalAlignment="{DynamicResource MarkerVerticalAlignment}" HorizontalAlignment="Stretch"
                            CornerRadius="2" Margin="{DynamicResource MarkerMargin}" OpacityMask="{DynamicResource MarkerMask}"
                            IsHitTestVisible="False" />
                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
                </Trigger>
                <!-- Pressed: shrink a little. -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="BarButtonFadeTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource ButtonCornerRadius}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{DynamicResource MarkerLineThickness}"
                    RenderTransformOrigin="0.5,0.5">
                <Grid>
                    <Border x:Name="HoverLayer" Opacity="0" CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    <!-- Active marker other than the line (Look.ActiveMarker): dot, pill or glow, in the line's color. -->
                    <Border Background="{TemplateBinding BorderBrush}" Visibility="{DynamicResource MarkerVisibility}"
                            Width="{DynamicResource MarkerWidth}" Height="{DynamicResource MarkerHeight}"
                            VerticalAlignment="{DynamicResource MarkerVerticalAlignment}" HorizontalAlignment="Stretch"
                            CornerRadius="2" Margin="{DynamicResource MarkerMargin}" OpacityMask="{DynamicResource MarkerMask}"
                            IsHitTestVisible="False" />
                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Flat button that highlights on hover; "BarButton" is set to one of these by ApplyLook. -->
        <Style x:Key="BarButtonInstant" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BarForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Tag" Value="{DynamicResource BarHover}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template" Value="{StaticResource BarButtonInstantTemplate}" />
        </Style>

        <Style x:Key="BarButtonFade" TargetType="Button" BasedOn="{StaticResource BarButtonInstant}">
            <Setter Property="Template" Value="{StaticResource BarButtonFadeTemplate}" />
        </Style>

        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource BarButtonInstant}" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Count badge for grouped windows ("3"). Hidden when there is no count. -->
        <Style x:Key="CountBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BarActive}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CountText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Window list: icon + title (+ count). Works for single windows and app groups. -->
        <DataTemplate x:Key="TaskWindowTemplate" DataType="{x:Type local:TaskItem}">
            <Button x:Name="Btn" Style="{DynamicResource BarButton}" Margin="1,0" Padding="8,0"
                    HorizontalContentAlignment="Stretch" ToolTip="{Binding Title}" Tag="{Binding HoverBrush}"
                    Click="TaskButton_Click" MouseUp="TaskButton_MouseUp"
                    MouseEnter="TaskButton_MouseEnter" MouseLeave="TaskButton_MouseLeave"
                    PreviewMouseLeftButtonDown="DragSource_PreviewDown" PreviewMouseMove="DragSource_PreviewMove"
                    PreviewMouseLeftButtonUp="DragSource_PreviewUp" LostMouseCapture="DragSource_LostCapture"
                    MouseRightButtonUp="WindowButton_RightUp">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="{DynamicResource TaskIconSize}" Height="{DynamicResource TaskIconSize}" Margin="0,0,8,0">
                        <Image x:Name="ColorIcon" Source="{Binding Icon}" Opacity="{DynamicResource ColorIconOpacity}"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Image x:Name="TintIcon" Source="{Binding TintedIcon}" Visibility="{DynamicResource TintIconVisibility}"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <Border DockPanel.Dock="Right" Style="{StaticResource CountBadge}" Margin="6,0,0,0">
                        <TextBlock Text="{Binding CountText}" FontSize="10" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <!-- In front: lighter background and a line (accent color, or the icon's color with glow). -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Btn" Property="Background" Value="{Binding ActiveBrush}" />
                    <Setter TargetName="Btn" Property="BorderBrush" Value="{Binding LineBrush}" />
                </DataTrigger>
                <!-- Tinted icons show their real colors on hover. -->
                <Trigger SourceName="Btn" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ColorIcon" Property="Opacity" Value="1" />
                    <Setter TargetName="TintIcon" Property="Opacity" Value="0" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Window list, icon only (Look.WindowIconsOnly): the title shows on hover, the count as a small badge. -->
        <DataTemplate x:Key="TaskWindowIconTemplate" DataType="{x:Type local:TaskItem}">
            <Button x:Name="Btn" Style="{DynamicResource BarButton}" Margin="1,0" Padding="6,0"
                    ToolTip="{Binding Title}" Tag="{Binding HoverBrush}"
                    Click="TaskButton_Click" MouseUp="TaskButton_MouseUp"
                    MouseEnter="TaskButton_MouseEnter" MouseLeave="TaskButton_MouseLeave"
                    PreviewMouseLeftButtonDown="DragSource_PreviewDown" PreviewMouseMove="DragSource_PreviewMove"
                    PreviewMouseLeftButtonUp="DragSource_PreviewUp" LostMouseCapture="DragSource_LostCapture"
                    MouseRightButtonUp="WindowButton_RightUp">
                <Grid>
                    <Grid Width="{DynamicResource TaskIconOnlySize}" Height="{DynamicResource TaskIconOnlySize}">
                        <Image x:Name="ColorIcon" Source="{Binding Icon}" Opacity="{DynamicResource ColorIconOpacity}"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Image x:Name="TintIcon" Source="{Binding TintedIcon}" Visibility="{DynamicResource TintIconVisibility}"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <Border Style="{StaticResource CountBadge}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,-6,-4" Padding="3,0" MinWidth="12">
                        <TextBlock Text="{Binding CountText}" FontSize="9" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Btn" Property="Background" Value="{Binding ActiveBrush}" />
                    <Setter TargetName="Btn" Property="BorderBrush" Value="{Binding LineBrush}" />
                </DataTrigger>
                <Trigger SourceName="Btn" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ColorIcon" Property="Opacity" Value="1" />
                    <Setter TargetName="TintIcon" Property="Opacity" Value="0" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The visible bar. Its contents are built from the design (see TaskbarView.Modules.cs). -->
    <!-- Tray icon template is added in code (TaskbarView.TrayModule.cs) so it can use the button style above. -->
    <!-- MaterialLayer draws the background (and a material's shader, if any) behind the icons, in the bar's shape. -->
    <Border x:Name="Surface">
        <Grid>
            <!-- Look.Shadow: a copy of the background with a drop shadow, under the real background. -->
            <Border x:Name="ShadowLayer" Background="{DynamicResource BarBackground}" Visibility="Collapsed" />
            <Border x:Name="MaterialLayer" Background="{DynamicResource BarBackground}" />
            <Border x:Name="Root" Margin="4,3" />
        </Grid>
    </Border>
</UserControl>
