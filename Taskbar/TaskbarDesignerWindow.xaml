<Window x:Class="WindowsCustomizer.TaskbarDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar designer" Width="1120" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="32" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Preview: the design drawn exactly like the real bar, over a dark background. -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Preview" FontWeight="SemiBold" />
            <Border x:Name="PreviewFrame" Height="80" Margin="0,4,0,12" CornerRadius="4" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A5F" Offset="0" />
                        <GradientStop Color="#4A2C5E" Offset="0.6" />
                        <GradientStop Color="#2A2A2A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <ContentControl x:Name="PreviewHost" VerticalAlignment="Top" />
            </Border>
        </StackPanel>

        <!-- Bottom: status and close -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" Padding="6,4" Click="Close_Click" />
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Apply to taskbar" Padding="10,4" Margin="0,0,8,0"
                    IsEnabled="False" Click="Apply_Click" />
            <CheckBox x:Name="LiveCheck" DockPanel.Dock="Right" Content="Update taskbar live" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,12,0" Click="LiveCheck_Click"
                      ToolTip="Off: the preview still updates, but the real taskbar only changes when you press Apply" />
            <TextBlock x:Name="StatusText" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Changes are saved automatically and show on the taskbar if this design is in use." />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Designs -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Designs" FontWeight="SemiBold" Margin="0,0,0,4" />
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                    <Button Content="New" Margin="0,0,3,3" Padding="4" Click="NewDesign_Click" />
                    <Button Content="Duplicate" Margin="3,0,0,3" Padding="4" Click="DuplicateDesign_Click" />
                    <Button Content="Delete" Margin="0,3,3,0" Padding="4" Click="DeleteDesign_Click" />
                    <Button x:Name="UseButton" Content="Use this" Margin="3,3,0,0" Padding="4" FontWeight="SemiBold"
                            Click="UseDesign_Click" />
                    <Button Content="Import..." Margin="0,6,3,0" Padding="4" Click="ImportDesign_Click"
                            ToolTip="Add a design from a .json file (for example one someone shared)" />
                    <Button Content="Export..." Margin="3,6,0,0" Padding="4" Click="ExportDesign_Click"
                            ToolTip="Save this design as a .json file to share or keep" />
                </UniformGrid>
                <ListBox x:Name="DesignList" SelectionChanged="DesignList_SelectionChanged" />
            </DockPanel>

            <!-- Zones -->
            <DockPanel Grid.Column="1" Margin="12,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Modules" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button DockPanel.Dock="Right" Content="Add" Padding="10,3" Click="AddModule_Click"
                            ToolTip="Adds the module to the selected zone, after the selected module" />
                    <ComboBox x:Name="AddModuleBox" Margin="0,0,6,0" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Style="{StaticResource ToolButton}" Content="◀" ToolTip="Move to the zone on the left" Click="MoveZoneLeft_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="▲" ToolTip="Move up (earlier in the zone)" Click="MoveUp_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="▼" ToolTip="Move down (later in the zone)" Click="MoveDown_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="▶" ToolTip="Move to the zone on the right" Click="MoveZoneRight_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="Remove" Click="RemoveModule_Click" />
                </StackPanel>

                <UniformGrid Columns="3">
                    <DockPanel Margin="0,0,4,0">
                        <TextBlock DockPanel.Dock="Top" Text="Left" Foreground="Gray" Margin="0,0,0,2" />
                        <ListBox x:Name="LeftList" SelectionChanged="ZoneList_SelectionChanged" GotFocus="ZoneList_GotFocus" />
                    </DockPanel>
                    <DockPanel Margin="2,0">
                        <TextBlock DockPanel.Dock="Top" Text="Center" Foreground="Gray" Margin="0,0,0,2" />
                        <ListBox x:Name="CenterList" SelectionChanged="ZoneList_SelectionChanged" GotFocus="ZoneList_GotFocus" />
                    </DockPanel>
                    <DockPanel Margin="4,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Right" Foreground="Gray" Margin="0,0,0,2" />
                        <ListBox x:Name="RightList" SelectionChanged="ZoneList_SelectionChanged" GotFocus="ZoneList_GotFocus" />
                    </DockPanel>
                </UniformGrid>
            </DockPanel>

            <!-- Options -->
            <TabControl x:Name="OptionTabs" Grid.Column="2">
                <TabItem x:Name="ModuleTab" Header="Module">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ModuleOptions" Margin="8" />
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="LookTab" Header="Look">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LookOptions" Margin="8" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
