<Window x:Class="WindowsCustomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Customizer" Height="340" Width="540">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: profile list -->
        <DockPanel Grid.Column="0">
            <Button DockPanel.Dock="Bottom" Content="Add profile" Margin="0,8,0,0" Padding="6"
                    Click="AddProfile_Click" />
            <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged" />
        </DockPanel>

        <!-- Right: settings of the selected profile -->
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <CheckBox x:Name="DarkCheck" Content="Dark mode" Click="DarkCheck_Click" />

            <TextBlock Text="Wallpaper" Margin="0,16,0,4" FontWeight="SemiBold" />
            <TextBlock x:Name="WallpaperText" TextWrapping="Wrap" Text="(none)" />
            <Button Content="Choose wallpaper..." Margin="0,8,0,0" Padding="6" HorizontalAlignment="Left"
                    Click="ChooseWallpaper_Click" />

            <Button Content="Apply profile" Margin="0,24,0,0" Padding="10,8" HorizontalAlignment="Left"
                    FontWeight="SemiBold" Click="Apply_Click" />
            <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="Gray" />
        </StackPanel>
    </Grid>
</Window>
