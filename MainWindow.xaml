<Window x:Class="WindowsCustomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Customizer" Height="580" Width="620">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: profile list -->
        <DockPanel Grid.Column="0">
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                <Button Content="Add" Margin="0,0,4,0" Padding="6" Click="AddProfile_Click" />
                <Button x:Name="DeleteButton" Content="Delete" Margin="4,0,0,0" Padding="6"
                        Click="DeleteProfile_Click" />
            </UniformGrid>
            <ListBox x:Name="ProfileList" DisplayMemberPath="Name"
                     SelectionChanged="ProfileList_SelectionChanged" />
        </DockPanel>

        <!-- Right: settings of the selected profile, then app-wide settings -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,4,0">
                <TextBlock Text="Name" Margin="0,0,0,4" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" LostFocus="NameBox_LostFocus" />

                <CheckBox x:Name="DarkCheck" Content="Dark mode" Margin="0,16,0,0" Click="DarkCheck_Click" />

                <TextBlock Text="Accent color" Margin="0,16,0,4" FontWeight="SemiBold" />
                <DockPanel>
                    <Border x:Name="AccentPreview" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0"
                            BorderBrush="Gray" BorderThickness="1" />
                    <TextBox x:Name="AccentBox" VerticalContentAlignment="Center" TextChanged="AccentBox_TextChanged" />
                </DockPanel>
                <TextBlock Text="#RRGGBB, or leave empty to keep the current accent" Margin="0,2,0,0"
                           Foreground="Gray" FontSize="11" />
                <WrapPanel x:Name="AccentSwatches" Margin="0,6,0,0" />

                <TextBlock Text="Cursor scheme" Margin="0,16,0,4" FontWeight="SemiBold" />
                <ComboBox x:Name="CursorBox" SelectionChanged="CursorBox_SelectionChanged" />

                <!-- Shown when the cursor scheme is "Custom..." -->
                <StackPanel x:Name="CustomCursorPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Import folder..." Padding="8,4" Click="ImportCursorFolder_Click" />
                        <Button Content="Clear all" Padding="8,4" Margin="8,0,0,0" Click="ClearCursors_Click" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,4" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                               Text="Hover over a row to try its cursor. Empty rows use the Windows default." />
                    <StackPanel x:Name="CustomCursorRows" />
                </StackPanel>

                <TextBlock Text="Wallpaper" Margin="0,16,0,4" FontWeight="SemiBold" />
                <ComboBox x:Name="KindBox" SelectionChanged="KindBox_SelectionChanged">
                    <ComboBoxItem Content="Image" />
                    <ComboBoxItem Content="Wallpaper Engine wallpaper" />
                    <ComboBoxItem Content="Wallpaper Engine profile" />
                </ComboBox>

                <TextBlock x:Name="ValueLabel" Margin="0,8,0,4" Foreground="Gray" TextWrapping="Wrap" />
                <DockPanel>
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                            Padding="8,2" Click="Browse_Click" />
                    <TextBox x:Name="ValueBox" TextChanged="ValueBox_TextChanged" />
                </DockPanel>

                <Button x:Name="ApplyButton" Content="Apply profile" Margin="0,24,0,0" Padding="10,8"
                        HorizontalAlignment="Left" FontWeight="SemiBold" Click="Apply_Click" />
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap" />

                <Separator Margin="0,16" />

                <TextBlock Text="Wallpaper Engine" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock x:Name="WeExeText" Foreground="Gray" TextWrapping="Wrap" />
                <Button Content="Set path..." Margin="0,8,0,0" Padding="6" HorizontalAlignment="Left"
                        Click="SetWallpaperEnginePath_Click" />

                <TextBlock Text="Custom taskbar" FontWeight="SemiBold" Margin="0,16,0,4" />
                <CheckBox x:Name="ShowTaskbarCheck" Content="Show custom taskbar" Click="ShowTaskbarCheck_Click" />
                <CheckBox x:Name="HideWindowsTaskbarCheck" Content="Hide the Windows taskbar" Margin="20,6,0,0"
                          Click="HideWindowsTaskbarCheck_Click"
                          ToolTip="Only while the custom taskbar is showing. If the taskbar ever stays hidden, run Restore-Taskbar.ps1 from the project folder." />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Screen edge" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="Gray" />
                    <ComboBox x:Name="TaskbarEdgeBox" Width="100" SelectionChanged="TaskbarEdgeBox_SelectionChanged">
                        <ComboBoxItem Content="Top" />
                        <ComboBoxItem Content="Bottom" />
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="Game mode" FontWeight="SemiBold" Margin="0,16,0,4" />
                <CheckBox x:Name="PauseForGamesCheck" Content="Pause Wallpaper Engine while a game is running"
                          Click="PauseForGamesCheck_Click" />
                <TextBlock Text="Game process names, comma-separated (for example: cs2, eldenring)"
                           Margin="0,8,0,4" Foreground="Gray" TextWrapping="Wrap" />
                <TextBox x:Name="GamesBox" LostFocus="GamesBox_LostFocus" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
