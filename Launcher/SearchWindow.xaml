<Window x:Class="WindowsCustomizer.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" SizeToContent="Height"
        WindowStartupLocation="Manual" Width="560"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Colors, sizes and font come from SearchLook (see ApplyLook). -->
    <Window.Resources>
        <SolidColorBrush x:Key="SearchBackground" Color="#F2202020" />
        <SolidColorBrush x:Key="SearchForeground" Color="White" />
        <SolidColorBrush x:Key="SearchHighlight" Color="#0078D4" />
        <SolidColorBrush x:Key="SearchHover" Color="#22FFFFFF" />

        <!-- Result rows: no default blue/gray selection, our own highlight instead. -->
        <Style x:Key="ResultRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SearchForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SearchHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SearchHighlight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" Background="{DynamicResource SearchBackground}" CornerRadius="10" Padding="12">
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16" VerticalAlignment="Center" Margin="4,0,12,0" Opacity="0.8"
                           Foreground="{DynamicResource SearchForeground}" />
                <Grid>
                    <TextBlock x:Name="Placeholder" Text="Search apps and the web" Opacity="0.55" IsHitTestVisible="False"
                               VerticalAlignment="Center" Foreground="{DynamicResource SearchForeground}" />
                    <TextBox x:Name="Box" Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource SearchForeground}" CaretBrush="{DynamicResource SearchForeground}"
                             VerticalContentAlignment="Center" />
                </Grid>
            </DockPanel>
            <ListBox x:Name="Results" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                     MaxHeight="440" Visibility="Collapsed" ItemContainerStyle="{StaticResource ResultRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </StackPanel>
    </Border>
</Window>
