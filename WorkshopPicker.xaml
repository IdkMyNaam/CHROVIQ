<Window x:Class="WindowsCustomizer.WorkshopPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a Wallpaper Engine wallpaper" Height="460" Width="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Filter by title" Margin="0,0,0,4" Foreground="Gray" />
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,8" TextChanged="FilterBox_TextChanged" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Content="Browse file..." Padding="8,4" Click="BrowseFile_Click" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="OK" IsDefault="True" Width="80" Margin="0,0,8,0" Click="Ok_Click" />
                <Button Content="Cancel" IsCancel="True" Width="80" />
            </StackPanel>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray" />
        </DockPanel>

        <ListBox x:Name="WallpaperList" MouseDoubleClick="WallpaperList_MouseDoubleClick" />
    </DockPanel>
</Window>
