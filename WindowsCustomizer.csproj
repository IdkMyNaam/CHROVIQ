<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004 (build 19041) or newer: needed for the media controls module (Windows.Media.Control). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Per-monitor DPI awareness, see app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 suggests WinForms' SetHighDpiMode instead of the manifest. That API only works for
         apps started by WinForms; this is a WPF app (WinForms is only used for the tray icon),
         so the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms/Drawing out of the global usings so Button, MessageBox, Application etc. stay WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scripts in Scripts\ are copied NEXT TO the .exe (Link flattens the folder), because the app looks
         for them there: the watchdog runs Restore-Taskbar.ps1 if the app is killed while it hides the taskbar,
         and the shell mode uses ShellLauncher.ps1 (starts Explorer whenever the app ends) and Restore-Shell.ps1. -->
    <None Update="Scripts\*.ps1" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <!-- The built-in materials (shaders) go next to the .exe as Materials\<name>\material.hlsl + material.json. -->
    <!-- (Removed and included again so %(RecursiveDir) is the material's folder, not the whole path from the project.) -->
    <None Remove="Materials\BuiltIn\**" />
    <None Include="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Materials\BuiltIn\**\*" CopyToOutputDirectory="PreserveNewest" Link="Materials\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
