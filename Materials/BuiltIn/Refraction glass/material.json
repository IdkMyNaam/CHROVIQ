{
  "Name": "Refraction glass",
  "Description": "What's behind is bent as if through a thick glass slab with rounded edges (Direct3D): color fringes, a soft blur, ripples if you like, and a highlight on the glass. Works with live glass.",
  "Renderer": "direct3d",
  "Animated": false,
  "UsesWallpaper": true,
  "Passes": [
    { "Entry": "Soften", "Scale": 0.5 },
    { "Entry": "Refract" }
  ],
  "Parameters": [
    { "Name": "Thickness", "Type": "Slider", "Min": 0, "Max": 2, "Default": "1", "Hint": "How strongly the edges bend what's behind." },
    { "Name": "Softness", "Type": "Slider", "Min": 0, "Max": 4, "Default": "1" },
    { "Name": "Ripples", "Type": "Slider", "Min": 0, "Max": 1, "Default": "0" },
    { "Name": "Color fringe", "Type": "Slider", "Min": 0, "Max": 1, "Default": "0.4" },
    { "Name": "Highlight", "Type": "Slider", "Min": 0, "Max": 1, "Default": "0.6" },
    { "Name": "Tint", "Type": "Color", "Default": "#FFFFFF" },
    { "Name": "Tint strength", "Type": "Slider", "Min": 0, "Max": 0.8, "Default": "0.06" }
  ]
}
