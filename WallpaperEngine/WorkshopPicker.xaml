<ui:FluentWindow x:Class="WindowsCustomizer.WorkshopPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Choose a Wallpaper Engine wallpaper" Height="540" Width="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Choose a Wallpaper Engine wallpaper" ShowMaximize="False" ShowMinimize="False" />

        <DockPanel Grid.Row="1" Margin="16,4,16,16">
            <ui:TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,10" PlaceholderText="Filter by title"
                        Icon="{ui:SymbolIcon Search24}" TextChanged="FilterBox_TextChanged" />

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <ui:Button DockPanel.Dock="Left" Content="Browse file..." Icon="{ui:SymbolIcon FolderOpen24}" Click="BrowseFile_Click" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="OK" Appearance="Primary" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="Ok_Click" />
                    <ui:Button Content="Cancel" IsCancel="True" MinWidth="80" />
                </StackPanel>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>

            <ui:Card Padding="4" VerticalContentAlignment="Stretch">
                <ListBox x:Name="WallpaperList" Background="Transparent" BorderThickness="0" MouseDoubleClick="WallpaperList_MouseDoubleClick" />
            </ui:Card>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
