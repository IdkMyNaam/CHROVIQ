<ui:FluentWindow x:Class="WindowsCustomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="CHROVIQ" Width="1040" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">

    <!-- WPF-UI's control styles only for this window (the taskbar, start menu and desktop keep their own looks). -->
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,20,0,8" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="CardText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="Card" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <!-- List entries as tiles (sidebar, profiles): hover = lighter, selected = accent border, like the designer. -->
            <Style x:Key="TileItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="CHROVIQ" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <ListBox x:Name="NavList" Grid.Column="0" Margin="8,4,4,8" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="Nav_SelectionChanged" ItemContainerStyle="{StaticResource TileItem}">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PaintBrush24" Margin="0,0,12,0" />
                        <TextBlock Text="Profiles" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PaintBucket24" Margin="0,0,12,0" />
                        <TextBlock Text="Appearance" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PanelBottom20" Margin="0,0,12,0" />
                        <TextBlock Text="Taskbar" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Search24" Margin="0,0,12,0" />
                        <TextBlock Text="Start, Search, Alt+Tab" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,12,0" />
                        <TextBlock Text="Desktop &amp; Shell" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Games24" Margin="0,0,12,0" />
                        <TextBlock Text="Wallpaper Engine &amp; games" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ChatHelp24" Margin="0,0,12,0" />
                        <TextBlock Text="Help &amp; support" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" Margin="0,0,12,0" />
                        <TextBlock Text="About" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- ============ Pages (one shown at a time) ============ -->
            <Grid Grid.Column="1" Margin="4,0,0,0">

                <!-- Profiles -->
                <ScrollViewer x:Name="PageProfiles" VerticalScrollBarVisibility="Auto" Padding="24,8,24,24">
                    <StackPanel MaxWidth="1000">
                        <TextBlock Text="Profiles" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource CardText}" Margin="0,-8,0,16"
                                   Text="A profile is a look you can switch to in one go: light or dark, accent color, cursors, taskbar design and wallpaper. Switch with the tray menu or Ctrl+Alt+P." />
                        <ui:CardControl Style="{StaticResource Card}" Margin="0,0,0,12">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Switch profiles automatically" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="AutoSwitchText" Style="{StaticResource CardText}"
                                               Text="By time of day (Night at 21:00), or while an app runs (Gaming while a game is open)." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Rules..." Icon="{ui:SymbolIcon List24}" Margin="0,0,12,0" Click="AutoSwitchRules_Click" />
                                <ui:ToggleSwitch x:Name="AutoSwitchCheck" Click="AutoSwitchCheck_Click" />
                            </StackPanel>
                        </ui:CardControl>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:Card Grid.Column="0" VerticalAlignment="Top" Margin="0,0,12,0" Padding="8">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Bottom" Content="Add an example..." Icon="{ui:SymbolIcon Sparkle24}" Margin="0,8,0,0"
                                               HorizontalAlignment="Stretch" Click="AddExampleProfile_Click"
                                               ToolTip="Ready-made profiles to start from: gaming, school, night" />
                                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                                        <ui:Button Content="Add" Icon="{ui:SymbolIcon Add24}" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                                   Click="AddProfile_Click" />
                                        <ui:Button x:Name="DeleteButton" Content="Delete" Icon="{ui:SymbolIcon Delete24}" Margin="4,0,0,0"
                                                   HorizontalAlignment="Stretch" Click="DeleteProfile_Click" />
                                    </UniformGrid>
                                    <ListBox x:Name="ProfileList" MinHeight="200" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource TileItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="ProfileList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="PaintBrush24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </ui:Card>

                            <StackPanel Grid.Column="1">
                                <ui:CardControl Style="{StaticResource Card}">
                                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Edit24" /></ui:CardControl.Icon>
                                    <ui:CardControl.Header>
                                        <TextBlock Text="Name" Style="{StaticResource CardTitle}" />
                                    </ui:CardControl.Header>
                                    <TextBox x:Name="NameBox" Width="240" TextChanged="NameBox_TextChanged" LostFocus="NameBox_LostFocus" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource Card}">
                                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="WeatherMoon24" /></ui:CardControl.Icon>
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Dark mode" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="Windows and apps in dark colors" Style="{StaticResource CardText}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="DarkCheck" Click="DarkCheck_Click" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource Card}">
                                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Color24" /></ui:CardControl.Icon>
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Accent color" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="#RRGGBB, or leave empty to keep the current accent" Style="{StaticResource CardText}" />
                                            <WrapPanel x:Name="AccentSwatches" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="AccentPreview" Width="28" Height="28" Margin="0,0,8,0" CornerRadius="4"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <TextBox x:Name="AccentBox" Width="120" VerticalContentAlignment="Center" TextChanged="AccentBox_TextChanged" />
                                    </StackPanel>
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource Card}">
                                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Cursor24" /></ui:CardControl.Icon>
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Mouse cursors" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="A Windows cursor scheme, or your own cursors (&quot;Custom...&quot;)" Style="{StaticResource CardText}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox x:Name="CursorBox" Width="240" SelectionChanged="CursorBox_SelectionChanged" />
                                </ui:CardControl>

                                <!-- Shown when the cursor scheme is "Custom..." -->
                                <ui:Card x:Name="CustomCursorPanel" Visibility="Collapsed" Margin="0,0,0,4">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="Import folder..." Icon="{ui:SymbolIcon FolderOpen24}" Click="ImportCursorFolder_Click" />
                                            <ui:Button Content="Clear all" Margin="8,0,0,0" Click="ClearCursors_Click" />
                                        </StackPanel>
                                        <TextBlock Margin="0,8,0,6" Style="{StaticResource CardText}"
                                                   Text="Hover over a row to try its cursor. Empty rows use the Windows default." />
                                        <StackPanel x:Name="CustomCursorRows" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:CardControl Style="{StaticResource Card}">
                                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="PanelBottom20" /></ui:CardControl.Icon>
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Taskbar design" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="Applying this profile switches the custom taskbar to this design" Style="{StaticResource CardText}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox x:Name="ProfileDesignBox" Width="240" SelectionChanged="ProfileDesignBox_SelectionChanged" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource Card}">
                                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Image24" /></ui:CardControl.Icon>
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Wallpaper" Style="{StaticResource CardTitle}" />
                                            <TextBlock x:Name="ValueLabel" Style="{StaticResource CardText}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox x:Name="KindBox" Width="240" SelectionChanged="KindBox_SelectionChanged">
                                        <ComboBoxItem Content="Image" />
                                        <ComboBoxItem Content="Wallpaper Engine wallpaper" />
                                        <ComboBoxItem Content="Wallpaper Engine profile" />
                                    </ComboBox>
                                </ui:CardControl>
                                <ui:Card Margin="0,0,0,4">
                                    <DockPanel>
                                        <ui:Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                                                   Icon="{ui:SymbolIcon FolderOpen24}" Click="Browse_Click" />
                                        <TextBox x:Name="ValueBox" TextChanged="ValueBox_TextChanged" />
                                    </DockPanel>
                                </ui:Card>

                                <ui:Button x:Name="ApplyButton" Content="Apply profile" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                           Margin="0,16,0,0" Padding="16,8" Click="Apply_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Appearance (app themes) -->
                <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" Padding="24,8,24,24" Visibility="Collapsed">
                    <StackPanel MaxWidth="1000">
                        <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource CardText}" Margin="0,-8,0,16"
                                   Text="How CHROVIQ's own windows look. Pick a theme, or make your own: every change shows right away. (The taskbar, desktop and start menu have their own designs.)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:Card Grid.Column="0" VerticalAlignment="Top" Margin="0,0,12,0" Padding="8">
                                <DockPanel>
                                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                                        <ui:Button Content="New" Icon="{ui:SymbolIcon Add24}" Margin="0,0,3,4" HorizontalAlignment="Stretch" Click="NewTheme_Click" />
                                        <ui:Button Content="Duplicate" Icon="{ui:SymbolIcon Copy24}" Margin="3,0,0,4" HorizontalAlignment="Stretch" Click="DuplicateTheme_Click" />
                                        <ui:Button x:Name="DeleteThemeButton" Content="Delete" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,3,4"
                                                   HorizontalAlignment="Stretch" Click="DeleteTheme_Click" />
                                        <ui:Button Content="Import..." Icon="{ui:SymbolIcon ArrowDownload24}" Margin="3,0,0,4" HorizontalAlignment="Stretch"
                                                   Click="ImportTheme_Click" />
                                        <ui:Button Content="Export..." Icon="{ui:SymbolIcon Share24}" Margin="0,0,3,0" HorizontalAlignment="Stretch"
                                                   Click="ExportTheme_Click" />
                                    </UniformGrid>
                                    <ListBox x:Name="ThemeList" MinHeight="240" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource TileItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="ThemeList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Margin="0,0,10,0"
                                                            Background="{Binding Swatch}" BorderBrush="{Binding AccentBrush}" BorderThickness="3" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </ui:Card>

                            <StackPanel Grid.Column="1">
                                <ui:InfoBar x:Name="BuiltInThemeNote" Title="Built-in theme" IsOpen="True" IsClosable="False" Severity="Informational"
                                            Margin="0,0,0,8" Message="Built-in themes can't be changed. Press Duplicate to make your own version of it." />
                                <StackPanel x:Name="ThemeEditorFields">
                                    <ui:CardControl Style="{StaticResource Card}">
                                        <ui:CardControl.Icon><ui:SymbolIcon Symbol="Edit24" /></ui:CardControl.Icon>
                                        <ui:CardControl.Header><TextBlock Text="Name" Style="{StaticResource CardTitle}" /></ui:CardControl.Header>
                                        <TextBox x:Name="ThemeNameBox" Width="240" LostFocus="ThemeNameBox_LostFocus" />
                                    </ui:CardControl>

                                    <ui:CardControl Style="{StaticResource Card}">
                                        <ui:CardControl.Icon><ui:SymbolIcon Symbol="WeatherMoon24" /></ui:CardControl.Icon>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="Light or dark" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="&quot;Follow Windows&quot; switches along with Windows' app mode" Style="{StaticResource CardText}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ComboBox x:Name="ThemeModeBox" Width="240" SelectionChanged="ThemeField_Changed">
                                            <ComboBoxItem Content="Follow Windows" />
                                            <ComboBoxItem Content="Light" />
                                            <ComboBoxItem Content="Dark" />
                                        </ComboBox>
                                    </ui:CardControl>

                                    <ui:CardControl Style="{StaticResource Card}">
                                        <ui:CardControl.Icon><ui:SymbolIcon Symbol="Color24" /></ui:CardControl.Icon>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="Accent color" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="Windows' own accent, or your color (#RRGGBB)" Style="{StaticResource CardText}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="ThemeWindowsAccentCheck" Content="Windows' accent" Margin="0,0,12,0" VerticalAlignment="Center"
                                                      Click="ThemeField_Changed" />
                                            <Border x:Name="ThemeAccentSwatch" Width="28" Height="28" Margin="0,0,8,0" CornerRadius="4"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                            <TextBox x:Name="ThemeAccentBox" Width="110" TextChanged="ThemeField_Changed" />
                                        </StackPanel>
                                    </ui:CardControl>

                                    <ui:CardControl Style="{StaticResource Card}">
                                        <ui:CardControl.Icon><ui:SymbolIcon Symbol="Image24" /></ui:CardControl.Icon>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="Background" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="Windows' materials (Mica, Acrylic, Tabbed), a color, or a picture" Style="{StaticResource CardText}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ComboBox x:Name="ThemeBackgroundBox" Width="240" SelectionChanged="ThemeField_Changed">
                                            <ComboBoxItem Content="Mica" />
                                            <ComboBoxItem Content="Acrylic (see-through)" />
                                            <ComboBoxItem Content="Tabbed (Mica, stronger)" />
                                            <ComboBoxItem Content="A color" />
                                            <ComboBoxItem Content="A picture" />
                                            <ComboBoxItem Content="A material (shader)" />
                                        </ComboBox>
                                    </ui:CardControl>

                                    <ui:CardControl x:Name="ThemeMaterialCard" Style="{StaticResource Card}">
                                        <ui:CardControl.Icon><ui:SymbolIcon Symbol="DesignIdeas24" /></ui:CardControl.Icon>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="Material" Style="{StaticResource CardTitle}" />
                                                <TextBlock x:Name="ThemeMaterialText" Style="{StaticResource CardText}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Content="Material settings..." Icon="{ui:SymbolIcon Settings24}" Click="ThemeMaterial_Click" />
                                    </ui:CardControl>

                                    <ui:CardControl x:Name="ThemeColorCard" Style="{StaticResource Card}">
                                        <ui:CardControl.Icon><ui:SymbolIcon Symbol="PaintBucket24" /></ui:CardControl.Icon>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="Background color" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="#RRGGBB; also shows under the picture. Empty: the light or dark default" Style="{StaticResource CardText}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <TextBox x:Name="ThemeBgColorBox" Width="240" TextChanged="ThemeField_Changed" />
                                    </ui:CardControl>

                                    <ui:Card x:Name="ThemePictureCard" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="Picture" Style="{StaticResource CardTitle}" />
                                            <DockPanel Margin="0,8,0,0">
                                                <ui:Button DockPanel.Dock="Right" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0"
                                                           Click="ThemeBrowseImage_Click" />
                                                <TextBox x:Name="ThemeImageBox" TextChanged="ThemeField_Changed" />
                                            </DockPanel>
                                            <TextBlock Text="How strongly the picture shows" Style="{StaticResource CardText}" Margin="0,10,0,0" />
                                            <Slider x:Name="ThemeImageOpacitySlider" Minimum="0.05" Maximum="1" ValueChanged="ThemeField_Changed" />
                                        </StackPanel>
                                    </ui:Card>

                                    <ui:Card Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="Rounded corners" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="Buttons, boxes, cards and menus: 0 is square, 4 is Windows' own" Style="{StaticResource CardText}" />
                                            <Slider x:Name="ThemeCornerSlider" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Margin="0,8,0,0" ValueChanged="ThemeField_Changed" />
                                        </StackPanel>
                                    </ui:Card>

                                    <ui:Card Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="Card transparency" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="Lower lets the background (Acrylic, a picture) show through the cards" Style="{StaticResource CardText}" />
                                            <Slider x:Name="ThemeCardSlider" Minimum="0.2" Maximum="1" Margin="0,8,0,0" ValueChanged="ThemeField_Changed" />
                                        </StackPanel>
                                    </ui:Card>

                                    <ui:CardControl Style="{StaticResource Card}">
                                        <ui:CardControl.Icon><ui:SymbolIcon Symbol="TextFont24" /></ui:CardControl.Icon>
                                        <ui:CardControl.Header><TextBlock Text="Font" Style="{StaticResource CardTitle}" /></ui:CardControl.Header>
                                        <ComboBox x:Name="ThemeFontBox" Width="240" SelectionChanged="ThemeField_Changed" />
                                    </ui:CardControl>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Taskbar -->
                <ScrollViewer x:Name="PageTaskbar" VerticalScrollBarVisibility="Auto" Padding="24,8,24,24" Visibility="Collapsed">
                    <StackPanel MaxWidth="1000">
                        <TextBlock Text="Taskbar" Style="{StaticResource PageTitle}" />

                        <ui:CardControl Style="{StaticResource Card}">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="PanelBottom20" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Show the custom taskbar" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="A bar on every monitor, in the design you choose below" Style="{StaticResource CardText}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="ShowTaskbarCheck" Click="ShowTaskbarCheck_Click" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource Card}">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="EyeOff24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Hide the Windows taskbar" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardText}"
                                               Text="Only while the custom taskbar shows. It comes back by itself if CHROVIQ closes, crashes or stops responding; Restore-Taskbar.ps1 next to the app is the manual way back." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="HideWindowsTaskbarCheck" Click="HideWindowsTaskbarCheck_Click" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource Card}">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Eye24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Show auto-hiding taskbars while this window is open" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardText}"
                                               Text="For designs with auto-hide: the bar comes in while CHROVIQ is on screen (not minimized), so you see what you change." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="ShowTaskbarWhileOpenCheck" Click="ShowTaskbarWhileOpenCheck_Click" />
                        </ui:CardControl>

