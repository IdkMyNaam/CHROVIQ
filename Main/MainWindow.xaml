                                <StackPanel>
                                    <TextBlock Text="Settings and logs" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Profiles, taskbar designs, desktop layout, backups, trace.log and shell.log" Style="{StaticResource CardText}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenDataFolder_Click" />
                        </ui:CardControl>
                        <ui:CardControl Style="{StaticResource Card}">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Bug24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Logs and problems" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardText}"
                                               Text="Read what the app has been doing, or put the logs, settings and PC details in one .zip on your desktop to attach to a bug report (nothing is sent)." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Show logs" Icon="{ui:SymbolIcon DocumentText24}" Margin="0,0,8,0" Click="ShowLogs_Click" />
                                <ui:Button Content="Report a problem..." Icon="{ui:SymbolIcon Bug24}" Click="ReportProblem_Click" />
                            </StackPanel>
                        </ui:CardControl>
                        <ui:CardControl Style="{StaticResource Card}">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Keyboard24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardText}"
                                               Text="Every shortcut in one place: next profile, open the start menu, search or Quick Settings, show or hide the taskbar and widgets, snap." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Keyboard shortcuts..." Icon="{ui:SymbolIcon Keyboard24}" Click="Hotkeys_Click" />
                        </ui:CardControl>
                        <ui:CardControl Style="{StaticResource Card}">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Sparkle24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Setup wizard" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardText}"
                                               Text="The few steps from the first start: the app's look, the taskbar, the Windows key and Alt+Tab." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Run it again" Icon="{ui:SymbolIcon Play24}" Click="RunSetupWizard_Click" />
                        </ui:CardControl>
                        <ui:CardControl Style="{StaticResource Card}">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArchiveArrowBack24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Back up and restore" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardText}"
                                               Text="Everything in one .zip: settings, profiles, desktop layout, app themes, taskbar designs and your materials. For a new PC, or a copy before trying things. A restore backs up your current settings first." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Back up..." Icon="{ui:SymbolIcon Save24}" Margin="0,0,8,0" Click="BackUpSettings_Click" />
                                <ui:Button Content="Restore..." Icon="{ui:SymbolIcon ArrowReset24}" Click="RestoreSettings_Click" />
                            </StackPanel>
                        </ui:CardControl>
                        <ui:CardControl Style="{StaticResource Card}">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Wrench24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="If something goes wrong" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardText}"
                                               Text="Restore-Taskbar.ps1 brings the Windows taskbar back; Restore-Shell.ps1 makes Explorer your shell again. Both are next to the app and work without it." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Show scripts" Icon="{ui:SymbolIcon Document24}" Click="OpenAppFolder_Click" />
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status line, for every page -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="24,6,24,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
</ui:FluentWindow>
