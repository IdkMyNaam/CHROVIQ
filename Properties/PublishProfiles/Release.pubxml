<?xml version="1.0" encoding="utf-8"?>
<!-- The build that people get (and that the installer packages): Scripts\Build-Installer.ps1, or
     dotnet publish -p:PublishProfile=Release
     ReadyToRun = the code is compiled ahead of time, so .NET has much less to compile when the app starts. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- .NET comes along, so the app runs on any PC without installing .NET first (the installer packs it). -->
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>bin\publish\</PublishDir>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
